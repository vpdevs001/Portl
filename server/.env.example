PORT=8000

# Local dev default — the Docker Postgres started with `bun run db:up`.
# In the production compose stack this is overridden to point at the
# internal `postgres` service (see docker-compose.prod.yml).
DATABASE_URL=postgresql://portl:portl@localhost:5432/portl

# Postgres container credentials — read by docker-compose.yml /
# docker-compose.prod.yml. Use a strong password in production.
POSTGRES_USER=portl
POSTGRES_PASSWORD=portl
POSTGRES_DB=portl
POSTGRES_PORT=5432

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of allowed CORS origins (optional)
# CORS_ORIGINS=http://localhost:8081,exp://192.168.1.10:8081

IMAGEKIT_PRIVATE_KEY=""
